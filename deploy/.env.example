# Copy to deploy/.env and change every secret. Never commit deploy/.env.

# Image tag to run (CD publishes to ghcr.io/<owner>/ltp-*)
LTP_IMAGE_PREFIX=ltp
LTP_VERSION=dev

# Public host name served by Caddy (localhost = self-signed cert)
LTP_DOMAIN=localhost

# PostgreSQL
POSTGRES_DB=ltp
POSTGRES_USER=ltp
POSTGRES_PASSWORD=change-me

# Workers exchange this token for a per-worker secret on registration
LTP_WORKER_REGISTRATION_TOKEN=change-me-to-a-long-random-string
LTP_WORKER_REPLICAS=2

# Admin user seeded on first start (US-23, T-03)
LTP_ADMIN_LOGIN=admin
LTP_ADMIN_PASSWORD=change-me

# Sign-in sessions (US-23): sign-out after this much inactivity (e.g. 30m, 8h, 1d)
LTP_SESSION_TIMEOUT=8h
# Cookies only over HTTPS. Keep true behind Caddy; false only for plain HTTP on a host other than localhost
LTP_SECURE_COOKIES=true
